body { 
    font-family: 'Inter', sans-serif; 
    position: relative;
    overflow-x: hidden;
}

/* Starry Background Effect */
body::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #000000;
    z-index: -2;
}

body::after {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    /* Uzay gibi görünmesi için çok fazla yıldız - 500+ yıldız */
    /* Her radial-gradient bir yıldız oluşturur: boyut boyut at x% y%, renk, şeffaflık */
    background-image: 
        /* Büyük yıldızlar (2px) - 80 adet */
        radial-gradient(2px 2px at 2% 5%, white, transparent),
        radial-gradient(2px 2px at 5% 12%, white, transparent),
        radial-gradient(2px 2px at 8% 20%, white, transparent),
        radial-gradient(2px 2px at 12% 8%, white, transparent),
        radial-gradient(2px 2px at 15% 25%, white, transparent),
