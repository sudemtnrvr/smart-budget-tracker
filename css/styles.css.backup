        radial-gradient(1px 1px at 81% 53%, white, transparent),
        radial-gradient(1px 1px at 81.5% 57%, white, transparent),
        radial-gradient(1px 1px at 82% 61%, white, transparent),
        radial-gradient(1px 1px at 82.5% 65%, white, transparent),
        radial-gradient(1px 1px at 83% 69%, white, transparent),
        radial-gradient(1px 1px at 83.5% 73%, white, transparent),
        radial-gradient(1px 1px at 84% 77%, white, transparent),
        radial-gradient(1px 1px at 84.5% 81%, white, transparent),
        radial-gradient(1px 1px at 85% 85%, white, transparent),
        radial-gradient(1px 1px at 85.5% 89%, white, transparent),
        radial-gradient(1px 1px at 86% 93%, white, transparent),
        radial-gradient(1px 1px at 86.5% 97%, white, transparent),
        radial-gradient(1px 1px at 87% 0%, white, transparent),
        radial-gradient(1px 1px at 87.5% 4%, white, transparent),
        radial-gradient(1px 1px at 88% 8%, white, transparent),
        radial-gradient(1px 1px at 88.5% 12%, white, transparent),
        radial-gradient(1px 1px at 89% 16%, white, transparent),
        radial-gradient(1px 1px at 89.5% 20%, white, transparent),
        radial-gradient(1px 1px at 90% 24%, white, transparent),
        radial-gradient(1px 1px at 90.5% 28%, white, transparent),
        radial-gradient(1px 1px at 91% 32%, white, transparent),
        radial-gradient(1px 1px at 91.5% 36%, white, transparent),
        radial-gradient(1px 1px at 92% 40%, white, transparent),
        radial-gradient(1px 1px at 92.5% 44%, white, transparent),
        radial-gradient(1px 1px at 93% 48%, white, transparent),
        radial-gradient(1px 1px at 93.5% 52%, white, transparent),
        radial-gradient(1px 1px at 94% 56%, white, transparent),
        radial-gradient(1px 1px at 94.5% 60%, white, transparent),
        radial-gradient(1px 1px at 95% 64%, white, transparent),
        radial-gradient(1px 1px at 95.5% 68%, white, transparent),
        radial-gradient(1px 1px at 96% 72%, white, transparent),
        radial-gradient(1px 1px at 96.5% 76%, white, transparent),
        radial-gradient(1px 1px at 97% 80%, white, transparent),
        radial-gradient(1px 1px at 97.5% 84%, white, transparent),
        radial-gradient(1px 1px at 98% 88%, white, transparent),
        radial-gradient(1px 1px at 98.5% 92%, white, transparent),
        radial-gradient(1px 1px at 99% 96%, white, transparent),
        radial-gradient(1px 1px at 99.5% 0%, white, transparent);
    background-size: 200% 200%;
    background-position: 0% 0%;
    animation: starry 20s linear infinite;
    z-index: -1;
    opacity: 0.8;
}

@keyframes starry {
    0% { background-position: 0% 0%; }
    100% { background-position: 100% 100%; }
}

/* Grain/Noise Effect */
body {
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.03'/%3E%3C/svg%3E");
    background-repeat: repeat;
}

/* Tema Ayarları */
.bg-dark { 
    background-color: transparent; 
    color: white; 
}

/* Light Mode - Devre Dışı (Sadece Siyah/Gri/Sarı) */
body.light-mode {
    background-color: #000000;
    color: #ffffff;
}

body.light-mode::before {
    background: #000000;
}

body.light-mode::after {
    opacity: 0.75;
}

body.light-mode .bg-dark {
    background-color: transparent;
    color: #ffffff;
}

body.light-mode .glass {
    background: rgba(15, 15, 15, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
}

body.light-mode .bg-slate-800,
body.light-mode .bg-slate-800\/50,
body.light-mode input,
body.light-mode select {
    background-color: rgba(0, 0, 0, 0.3) !important;
    color: #ffffff !important;
    border-color: rgba(255, 255, 255, 0.1) !important;
}

body.light-mode .text-gray-400 {
    color: rgba(255, 255, 255, 0.5) !important;
}

body.light-mode .text-gray-300 {
    color: rgba(255, 255, 255, 0.7) !important;
}

body.light-mode .text-white {
    color: #ffffff !important;
}

/* Modern Glassmorphism Kartlar */
.glass {
    background: rgba(15, 15, 15, 0.6);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
}

/* Yellow Accent Color */
.accent-yellow {
    color: #FFC700;
}

.bg-accent-yellow {
    background-color: #FFC700;
    color: #000000;
}

.bg-accent-yellow:hover {
    background-color: #FFD700;
}

/* Modern Button Styles */
.modern-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: white;
    font-weight: 500;
    border-radius: 8px;
    transition: all 0.3s ease;
    cursor: pointer;
}

.modern-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
}

.modern-btn-yellow {
    background: #FFC700;
    color: #000000;
    border: none;
}

.modern-btn-yellow:hover {
    background: #FFD700;
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(255, 199, 0, 0.4);
}


/* Sekme Geçiş Animasyonu */
.tab-content { 
    display: none; 
    animation: fadeIn 0.4s ease; 
}

.tab-content.active { 
    display: block; 
}

@keyframes fadeIn {
    from { 
        opacity: 0; 
        transform: translateY(10px); 
    }
    to { 
        opacity: 1; 
        transform: translateY(0); 
    }
}

/* Scrollbar Styling */
.hide-scroll::-webkit-scrollbar { 
    display: none; 
}

::-webkit-scrollbar {
    width: 8px;
}

::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.05);
}

::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.3);
}

/* Top Navigation Styles (Studio Lumio Style) */
#top-nav {
    backdrop-filter: blur(20px);
    background: rgba(0, 0, 0, 0.3);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

/* Mobil için navbar inceltme */
@media (max-width: 1023px) {
    #top-nav {
        padding-top: 0.75rem !important;
        padding-bottom: 0.75rem !important;
        padding-left: 1rem !important;
        padding-right: 1rem !important;
    }
    
    #top-nav .w-10 {
        width: 2rem;
        height: 2rem;
    }
    
    #top-nav .w-5 {
        width: 1rem;
        height: 1rem;
    }
}

/* Desktop için navbar hafif inceltme */
@media (min-width: 1024px) {
    #top-nav {
        padding-top: 1rem !important;
        padding-bottom: 1rem !important;
    }
}

.nav-link {
    color: rgba(255, 255, 255, 0.5) !important;
    background: transparent !important;
    border: none;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: none;
    border-radius: 6px;
}

.nav-link:hover {
    color: rgba(255, 255, 255, 0.5) !important;
    background: transparent !important;
}

.nav-link.active-nav {
    color: rgba(255, 255, 255, 0.5) !important;
    background: transparent !important;
}

/* Sarı renk override'larını kaldır */
.nav-link.active-nav,
.nav-link[data-tab].active-nav,
button.nav-link.active-nav {
    color: rgba(255, 255, 255, 0.5) !important;
    background: transparent !important;
}

/* Mobil Dropdown Menu - Full Screen */
#mobile-dropdown {
    animation: slideDown 0.4s ease-out;
    background: #000000 !important;
    backdrop-filter: none !important;
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    min-height: 100vh !important;
    z-index: 90 !important;
    margin: 0 !important;
    padding: 0 !important;
}

/* Dropdown açıkken navbar'ı görünür tut */
#mobile-dropdown:not(.hidden) ~ * #top-nav,
body:has(#mobile-dropdown:not(.hidden)) #top-nav {
    z-index: 100 !important;
    position: relative;
}

/* Dropdown açıkken navbar'daki çarpı ikonunu görünür yap */
#mobile-dropdown:not(.hidden) ~ * #mobile-menu-btn,
body:has(#mobile-dropdown:not(.hidden)) #mobile-menu-btn {
    z-index: 101 !important;
    position: relative;
}

#mobile-dropdown:not(.hidden) {
    display: flex !important;
}

#mobile-dropdown.hidden {
    display: none !important;
}

/* Dropdown açıkken body ve diğer elementleri gizle */
body:has(#mobile-dropdown:not(.hidden)) {
    overflow: hidden !important;
}

@keyframes slideDown {
    from {
        opacity: 0;
        transform: translateY(-100%);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

#mobile-menu-btn {
    transition: transform 0.3s ease;
    z-index: 60;
    position: relative;
}

#mobile-menu-btn:active {
    transform: scale(0.95);
}

/* Mobil dropdown içindeki butonlar - Sadece Text */
#mobile-dropdown button {
    background: transparent;
    border: none;
    cursor: pointer;
    transition: color 0.2s ease;
}

/* Dropdown açıkken navbar'ı gizle */
#mobile-dropdown:not(.hidden) ~ * {
    pointer-events: none;
}

/* Desktop Navigation Styles (Legacy - for sidebar if needed) */
.desktop-nav-btn {
    color: rgba(255, 255, 255, 0.5) !important;
    background: transparent !important;
    border: 1px solid transparent;
    transition: none;
}

.desktop-nav-btn:hover {
    background: transparent !important;
    color: rgba(255, 255, 255, 0.5) !important;
    border-color: transparent;
}

.desktop-nav-btn.active-nav {
    background: transparent !important;
    color: rgba(255, 255, 255, 0.5) !important;
    font-weight: 500;
    border-color: transparent;
}


/* Modern Input Styles */
input, select, textarea {
    background: rgba(255, 255, 255, 0.05) !important;
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
    color: white !important;
    transition: all 0.3s ease;
}

input:focus, select:focus, textarea:focus {
    background: rgba(255, 255, 255, 0.08) !important;
    border-color: #FFC700 !important;
    outline: none;
    box-shadow: 0 0 0 3px rgba(255, 199, 0, 0.1);
}

input::placeholder, textarea::placeholder {
    color: rgba(255, 255, 255, 0.4) !important;
}

/* Card Hover Effects */
.glass:hover {
    border-color: rgba(255, 255, 255, 0.15);
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4);
    transition: all 0.3s ease;
}

/* Typography Improvements */
h1, h2, h3, h4, h5, h6 {
    letter-spacing: -0.03em;
    font-weight: 700;
}

h1 {
    font-weight: 800;
}

/* Large Hero Text */
.text-hero {
    font-size: clamp(3rem, 8vw, 7rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.1;
}

/* Modern Link Styles */
a {
    color: #FFC700;
    text-decoration: none;
    transition: color 0.3s ease;
}

a:hover {
    color: #FFD700;
}

/* Bottom Navigation Active State */
#bottom-nav button.active-tab {
    color: #FFC700;
}

#bottom-nav button.active-tab i {
    color: #FFC700;
}

/* Accent Yellow Text */
.accent-yellow {
    color: #FFC700 !important;
}

/* Navigasyon butonlarında accent-yellow class'ını override et - TÜM DURUMLAR İÇİN */
.nav-link,
.nav-link.accent-yellow,
.nav-link.active-nav,
.nav-link.active-nav.accent-yellow,
button.nav-link,
button.nav-link.accent-yellow,
button.nav-link.active-nav,
button.nav-link.active-nav.accent-yellow,
#top-nav .nav-link,
#top-nav .nav-link.accent-yellow,
#top-nav .nav-link.active-nav,
#top-nav button.nav-link,
#top-nav button.nav-link.accent-yellow,
#top-nav button.nav-link.active-nav {
    color: rgba(255, 255, 255, 0.5) !important;
    background: transparent !important;
}

.desktop-nav-btn,
.desktop-nav-btn.accent-yellow,
.desktop-nav-btn.active-nav,
.desktop-nav-btn.active-nav.accent-yellow {
    color: rgba(255, 255, 255, 0.5) !important;
    background: transparent !important;
}

/* Responsive adjustments */
@media (min-width: 1024px) {
    .tab-content {
        animation: fadeIn 0.3s ease;
    }
}

/* Glow Effects */
.glow-yellow {
    box-shadow: 0 0 20px rgba(255, 199, 0, 0.3);
}

/* Modern Badge/Tag Styles */
.badge {
    display: inline-flex;
    align-items: center;
    padding: 4px 12px;
    background: rgba(255, 199, 0, 0.1);
    border: 1px solid rgba(255, 199, 0, 0.2);
    color: #FFC700;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 500;
}

/* Smooth Transitions */
* {
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
}

/* Splash Screen Animations */
#splash-screen {
    background: transparent;
    backdrop-filter: none;
}

#splash-title {
    animation: fadeInUp 1.2s ease-out forwards;
    text-shadow: 0 0 40px rgba(255, 199, 0, 0.3);
    letter-spacing: -0.04em;
    font-weight: 800;
    position: relative;
}

#splash-continue-btn {
    animation: fadeInUp 0.8s ease-out 1.2s forwards;
    transform: translateY(20px);
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Splash Screen Fade Out */
#splash-screen.fade-out {
    animation: fadeOut 0.6s ease-out forwards;
}

@keyframes fadeOut {
    from {
        opacity: 1;
    }
    to {
        opacity: 0;
        visibility: hidden;
    }
}

/* Enhanced Card Styles */
.glass {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Yellow Glow on Hover for Yellow Buttons */
.modern-btn-yellow:hover {
    box-shadow: 0 4px 20px rgba(255, 199, 0, 0.4), 0 0 0 1px rgba(255, 199, 0, 0.2);
}

/* Better Focus States */
button:focus-visible,
input:focus-visible,
select:focus-visible {
    outline: 2px solid #FFC700;
    outline-offset: 2px;
}

/* Improved Text Selection */
::selection {
    background: rgba(255, 199, 0, 0.3);
    color: white;
}
